# Application
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/gomatric

# JWT Authentication
JWT_ACCESS_SECRET=gomatric_dev_access_secret_super_secure_key_12345!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gomatric_dev_refresh_secret_super_secure_key_67890!
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Documentation
SWAGGER_ENABLED=true
